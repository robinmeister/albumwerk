# HTTPS-Reverse-Proxy für den Produktivbetrieb (siehe docker-compose.yml).
#
# Standard: „Eigene Domain" wird im Einrichtungs-Assistenten der App eingetragen.
# Caddy holt dann automatisch ein Let's-Encrypt-Zertifikat für genau diese
# Domain (On-Demand-TLS). Die App bestätigt jede Domain über den Endpoint
# /api/custom/domain/ask — es werden nur Zertifikate für die eingetragene
# Domain ausgestellt. Es muss hier nichts editiert werden.
{
	on_demand_tls {
		ask http://app:8090/api/custom/domain/ask
	}
}

https:// {
	tls {
		on_demand
	}
	reverse_proxy app:8090
}

# --- Alternative: feste Domain (statt On-Demand) --------------------------
# Wer die Domain lieber fest verdrahten möchte, kann stattdessen den Block
# oben löschen und hier die eigene Domain eintragen:
#
# fotos.example.com {
# 	reverse_proxy app:8090
# }
