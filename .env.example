# Einstellungen für die eigene (Produktions-)Instanz.
# Diese Datei nach ".env" kopieren und ausfüllen:  cp .env.example .env
# Die .env wird nicht ins Git-Repository eingecheckt.

# Zugangsdaten für das Administrations-Backend (PocketBase, .../_/).
# Damit melden Sie sich unter http://IHRE-ADRESSE:8090/_/ an.
# Das Passwort muss mindestens 10 Zeichen lang sein.
PB_SUPERUSER_EMAIL=sie@example.com
PB_SUPERUSER_PASSWORD=bitte-sicheres-passwort-waehlen

# Port, unter dem die App erreichbar ist (nur ändern, falls 8090 belegt ist).
APP_PORT=8090
