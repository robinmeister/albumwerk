# SaaS-Betrieb — Konfiguration für Provisioning, Backups und Control-Plane.
# Nach ".env" kopieren und ausfüllen:  cp .env.example .env
# Die .env wird nicht ins Git-Repository eingecheckt.

# --- Coolify (PaaS auf dem SaaS-VPS) ---------------------------------------
# API-Token: Coolify-UI → Keys & Tokens → API tokens
COOLIFY_URL=https://coolify.albumwerk.de
COOLIFY_TOKEN=
# UUIDs: Coolify-UI → Projekt/Server öffnen, UUID steht in der URL
COOLIFY_PROJECT_UUID=
COOLIFY_SERVER_UUID=
COOLIFY_ENVIRONMENT_NAME=production

# --- Kunden-Instanzen --------------------------------------------------------
# Basis-Domain: Kunden bekommen https://<subdomain>.$SAAS_DOMAIN
# (Wildcard-DNS *.albumwerk.de muss auf den VPS zeigen!)
SAAS_DOMAIN=albumwerk.de
# Gepinntes Produkt-Image (nach jedem Release bewusst hochziehen)
APP_IMAGE=gitea.robinhm.de/robinmeister/albumwerk
APP_TAG=v0.1.0

# --- Zentrales SMTP-Relay (für alle Kunden-Instanzen + Control-Plane) --------
# Ohne SMTP verschicken frische Instanzen keine Bestell-/Anmelde-Mails.
SAAS_SMTP_HOST=
SAAS_SMTP_PORT=587
SAAS_SMTP_USER=
SAAS_SMTP_PASS=
SAAS_SMTP_SENDER=noreply@albumwerk.de
SAAS_SMTP_SENDER_NAME=Albumwerk

# --- Uptime Kuma (optional; leer lassen = Monitor-Anlage wird übersprungen) --
KUMA_URL=
KUMA_USER=
KUMA_PASS=

# --- Zentrale Backups (backup-sync.sh) ---------------------------------------
# rclone-Remote (z. B. Hetzner Storage Box): vorher `rclone config` ausführen.
RCLONE_REMOTE=storagebox:albumwerk-backups
# Wurzel der Kunden-Volumes auf dem VPS (Coolify-Standard, ggf. anpassen)
VOLUME_ROOT=/var/lib/docker/volumes
# Fehler-Benachrichtigung (leer = keine Mail)
BACKUP_ALERT_EMAIL=

# --- Control-Plane (saas/control) --------------------------------------------
CONTROL_SUPERUSER_EMAIL=
CONTROL_SUPERUSER_PASSWORD=
